{
  "name": "securebuilderbot",
  "version": "0.1.2",
  "description": "Secure Builder Bot from the terminal: securebuilderbot init writes the setup and opens the pull request, securebuilderbot run runs the gates locally",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "securebuilderbot": "bin/securebuilderbot.js"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
