{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && make --no-print-directory -s check-fast 2>&1 || exit 2"
          }
        ]
      }
    ]
  }
}
