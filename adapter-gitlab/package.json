{
  "name": "@securebuilderbot/adapter-gitlab",
  "version": "0.1.1",
  "private": true,
  "description": "Secure Builder Bot on GitLab: the CI/CD component and the merge request publisher",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
