#!/usr/bin/env bash
# sentinel/run — the sentinel module's command line, from anywhere in the repository.
# Usage: sentinel/run proofset [--case NAME]
# WHY: the replay imports core, standards and qa as well as sentinel, so every module's package
# (<module>/securebuilderbot_<module>/) goes on the path, exactly as core/run does it.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
path="$here"
for pkg in "$root"/*/securebuilderbot_*/; do
  dir="$(dirname "${pkg%/}")"
  [ "$dir" = "$here" ] || path="$path:$dir"
done
exec env PYTHONPATH="$path${PYTHONPATH:+:$PYTHONPATH}" python3 -m securebuilderbot_sentinel "$@"
