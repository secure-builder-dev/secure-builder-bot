#!/usr/bin/env bash
# core/run — the core module's command line, from anywhere in the repository.
# Usage: core/run <run|config|profile|classify|scan-verdict|scan-precondition> [args]
# Every module's Python package (<module>/securebuilderbot_<module>/) goes on the path, so the
# runner finds the gate modules that are installed (runner.py:discover_gate) with no edit here.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
path="$here"
for pkg in "$root"/*/securebuilderbot_*/; do
  dir="$(dirname "${pkg%/}")"
  [ "$dir" = "$here" ] || path="$path:$dir"
done
# The working directory is the repository under review, a pull request's checkout in CI. `python3 -m`
# would put it first on sys.path, so a yaml.py or a securebuilderbot_core/ committed there would run
# as core. It is dropped from the path before anything else is imported, on every Python version, and
# in this process only: an environment setting would reach the user's own suite, which QA runs as a child.
exec env PYTHONPATH="$path${PYTHONPATH:+:$PYTHONPATH}" python3 -c '
import sys
sys.path[:] = [p for p in sys.path if p not in ("", ".")]
import runpy
runpy.run_module("securebuilderbot_core", run_name="__main__", alter_sys=True)
' "$@"
